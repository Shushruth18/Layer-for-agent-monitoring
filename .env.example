# Otari gateway (OpenAI-compatible). Hosted: https://api.otari.ai/api/v1  (EU: https://eu.api.otari.ai/api/v1)
OPENAI_BASE_URL=https://api.otari.ai/api/v1
# Otari virtual keys (one per role, each with its own small budget)
AGENT_LLM_KEY=otk_replace_me
JUDGE_LLM_KEY=otk_replace_me
# Model selectors as shown in the Otari dashboard (or routing-policy names for fallback)
AGENT_MODEL=
JUDGE_MODEL=
# Windows: folder containing the GTK/Pango DLLs for WeasyPrint
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin
# Dashboard -> engine API
NEXT_PUBLIC_API_URL=http://localhost:8000
