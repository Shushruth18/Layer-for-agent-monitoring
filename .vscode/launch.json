{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Engine (8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["engine.main:app", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Debug Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "agent.run",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Agent (no monitor)",
      "type": "debugpy",
      "request": "launch",
      "module": "agent.run",
      "args": ["--no-monitor"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
